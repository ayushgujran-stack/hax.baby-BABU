PORT=3001
NODE_ENV=development
DB_PATH=./data/paci_boss.db
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# =============================================================================
# FIREBASE CLOUD FIRESTORE CONFIGURATION (VISITOR ODOMETER ONLY)
# =============================================================================
# Option A: Path to service account JSON file OR raw JSON string
# FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json

# Option B: Individual Service Account Credentials
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgI...\n-----END PRIVATE KEY-----\n"

# Option C: Standard Google Cloud Application Default Credentials
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json
