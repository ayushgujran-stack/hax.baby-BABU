rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Aggregate Visitor Counter Document: Publicly readable, server-only writable
    match /siteStats/visitorCounter {
      allow read: if true;
      allow write: if false; // Mutated ONLY by secure server-side endpoint / Cloud Functions via Admin SDK
    }

    // Public Guestbook Collection: Publicly readable for live reviews feed,
    // writable ONLY by secure server-side endpoint / Cloud Functions via Admin SDK
    // to enforce server-side sentiment classification, length limits, and anti-abuse validation
    match /guestbook/{messageId} {
      allow read: if true;
      allow write: if false;
    }

    // Orders Collection: Publicly creatable for approved products,
    // cannot be read publicly or deleted/updated by unauthorized clients
    match /orders/{orderId} {
      allow create: if request.resource.data.product in [
        "Pacifier my aunt gifted",
        "Found at Suzie’s house",
        "It just spawned on my bedroom"
      ];
      allow read, update, delete: if false;
    }

    // Default deny for all other collections and documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
