rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Aggregate Visitor Counter Document: Publicly readable, atomic counter
    match /siteStats/visitorCounter {
      allow read: if true;
      allow create, update: if true;
    }

    // Public Guestbook Collection: Publicly readable for live reviews feed,
    // public creation allowed with length validation
    match /guestbook/{messageId} {
      allow read: if true;
      allow create: if request.resource.data.message is string
                    && request.resource.data.message.size() >= 5
                    && request.resource.data.message.size() <= 500;
      allow update, delete: if false;
    }

    // Orders Collection: Publicly creatable for approved products,
    // cannot be read publicly or deleted/updated by unauthorized clients
    match /orders/{orderId} {
      allow create: if request.resource.data.product in [
        "Pacifier my aunt gifted",
        "Found at Suzie’s house",
        "It just spawned on my bedroom"
      ];
      allow read, update, delete: if false;
    }

    // Default deny for all other collections and documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
